# Public site URL (used for canonical URLs, sitemap, Open Graph and structured data)
# MUST match the domain that actually serves the site (canonical URLs, sitemap, Open Graph, structured data).
# If unset on Vercel, the project's production URL is used automatically.
NEXT_PUBLIC_SITE_URL=https://www.apardynamics.com

# Search engine ownership tokens (paste only the token value from Search Console / Bing Webmaster Tools)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Quote form delivery (server-side only, never exposed to the browser) ---
# Create a key at https://resend.com
RESEND_API_KEY=

# Enquiries are emailed to info@apardynamics.com by default. Override (comma-separated) only if needed:
# QUOTE_TO_EMAIL=info@apardynamics.com

# Required to deliver to anyone other than the Resend account owner: verify apardynamics.com in Resend
# (Domains), then set a sender on that domain. Without it the shared test sender is used and Resend rejects
# other recipients.
# QUOTE_FROM_EMAIL=Apar Dynamics Website <quotes@apardynamics.com>
