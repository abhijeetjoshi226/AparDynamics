# Public site URL (used for canonical URLs, sitemap, Open Graph and structured data)
NEXT_PUBLIC_SITE_URL=https://www.apardynamics.com

# --- Quote form delivery (server-side only, never exposed to the browser) ---
# Create a key at https://resend.com and verify your sending domain.
RESEND_API_KEY=
# Where enquiries are delivered
QUOTE_TO_EMAIL=info@apardynamics.com
# Verified sender, e.g. "Apar Dynamics Website <quotes@apardynamics.com>"
QUOTE_FROM_EMAIL=
