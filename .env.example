# Public site URL (used for canonical URLs, sitemap, Open Graph and structured data)
NEXT_PUBLIC_SITE_URL=https://www.apardynamics.com

# --- Quote form delivery (server-side only, never exposed to the browser) ---
# Create a key at https://resend.com (use the account registered with Abhijeetjoshi226@gmail.com while testing).
RESEND_API_KEY=

# TESTING (default): leave QUOTE_TO_EMAIL and QUOTE_FROM_EMAIL unset.
#   Enquiries go to Abhijeetjoshi226@gmail.com from onboarding@resend.dev, subject prefixed "[TEST]".
#
# LIVE: after verifying apardynamics.com in Resend, set both:
# QUOTE_TO_EMAIL=info@apardynamics.com
# QUOTE_FROM_EMAIL=Apar Dynamics Website <quotes@apardynamics.com>
